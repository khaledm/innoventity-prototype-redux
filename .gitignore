.vs/
.vscode/settings.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test results
TestResults/
coverage/
*.trx

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/

# Secrets and local configuration
*.env
.env*
appsettings.*.local.json
secrets.json
*.pfx
*.p12

# OS files
.DS_Store
Thumbs.db
*.swp
*.log

# EF Core migrations (keep migration files, ignore temporary)
**/Migrations/*.Designer.cs

# Temporary development files
commit-*.txt
test-*.txt

# Node modules (for future frontend)
node_modules/
dist/
.specify/memory/constitution.md.bak

# Playwright test artifacts
test-results/
playwright-report/
playwright/.cache/

# act (local GitHub Actions runner)
.secrets
.actrc

# Terraform — secrets and generated files (NEVER commit these)
infrastructure/**/*.tfvars
infrastructure/**/.terraform/
infrastructure/**/.terraform.lock.hcl
infrastructure/**/terraform.tfstate
infrastructure/**/terraform.tfstate.backup
infrastructure/**/tfplan
infrastructure/**/tfplan-destroy
infrastructure/**/outputs.json

# to prevent accidental credential leakag
.claude
